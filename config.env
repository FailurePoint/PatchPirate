# GitHub Personal Access Token (required for larger profiles, uncomment to use)
# GITHUB_TOKEN = ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dissable lookups for assosiated profiles and profile photos (True to disable)
DISABLE_LOOKUPS = False

# Dissable profile information pannel (True to disable)
DISABLE_PROFILE_INFO = False

# Enable log file of all sources of discovered email addresses (True to enable)
VERBOSE_SOURCES_LOGGING = False

# Dissable first seen commit  text in UI
DISABLE_FIRST_SEEN = False